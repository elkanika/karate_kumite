<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <h1>Competitors</h1>
  <%= link_to "New competitor", new_competitor_path, class: "btn btn-primary" %>
</div>

<div class="card" style="margin-bottom: 2rem; padding: 1rem;">
  <%= form_with url: competitors_path, method: :get, local: true, class: "actions", style: "align-items: end; gap: 1rem;" do |form| %>
    <div class="form-group" style="margin-bottom: 0; flex-grow: 1;">
      <%= form.label :name, "Search by Name", class: "form-label" %>
      <%= form.text_field :name, value: params[:name], class: "form-control", placeholder: "Daniel..." %>
    </div>

    <div class="form-group" style="margin-bottom: 0; width: 200px;">
      <%= form.label :belt, "Filter by Belt", class: "form-label" %>
      <%= form.select :belt, Competitor::VALID_BELTS, { include_blank: "All Belts", selected: params[:belt] }, { class: "form-control" } %>
    </div>

    <%= form.submit "Search", class: "btn btn-primary" %>
    <%= link_to "Clear", competitors_path, class: "btn btn-secondary" %>
  <% end %>
</div>

<div id="competitors" class="grid">
  <% @competitors.each do |competitor| %>
    <div class="card" id="<%= dom_id competitor %>">
      <div style="display: flex; justify-content: space-between; align-items: start;">
        <h2><%= competitor.first_name %> <%= competitor.last_name %></h2>
        <span class="badge <%= competitor.belt.downcase %>"><%= competitor.belt %> Belt</span>
      </div>
      
      <p class="text-muted">
        <strong>Age:</strong> <%= competitor.age %> | 
        <strong>Dojo:</strong> <%= competitor.dojo %>
      </p>

      <div class="actions">
        <%= link_to "Show", competitor, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>
