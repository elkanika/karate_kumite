<div class="container" style="max-width: 600px;">
  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h1 style="margin: 0; border: none;"><%= @competitor.first_name %> <%= @competitor.last_name %></h1>
      <span class="badge <%= @competitor.belt.downcase %>" style="font-size: 1rem; padding: 0.5rem 1rem;"><%= @competitor.belt %> Belt</span>
    </div>

    <div style="margin-bottom: 2rem;">
      <p><strong>Age:</strong> <%= @competitor.age %></p>
      <p><strong>Dojo:</strong> <%= @competitor.dojo %></p>
    </div>

    <div class="actions" style="justify-content: space-between; border-top: 1px solid #eee; padding-top: 1.5rem;">
      <%= link_to "Back to competitors", competitors_path, class: "btn btn-secondary" %>
      
      <div style="display: flex; gap: 0.5rem;">
        <%= link_to "Edit", edit_competitor_path(@competitor), class: "btn btn-primary" %>
        <%= button_to "Destroy", @competitor, method: :delete, class: "btn btn-secondary", style: "background-color: #d32f2f; color: white;" %>
      </div>
    </div>
  </div>
</div>
